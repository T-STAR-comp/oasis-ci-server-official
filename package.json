{
  "name": "oasis-ci-server",
  "private": true,
  "type": "module",
  "main": "server.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node server.cjs",
    "start:tsx": "tsx src/server.ts",
    "build:app": "node scripts/build-app.mjs",
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/database',{recursive:true});fs.copyFileSync('src/database/schema.sql','dist/database/schema.sql');\"",
    "build:all": "npm run build:app && npm run build",
    "bundle:app": "node scripts/bundle-app-dist.mjs",
    "build:deploy": "npm run build:all && npm run bundle:app",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.3",
    "h3-v2": "npm:h3@2.0.1-rc.20",
    "nodemailer": "^7.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {}
}
